# ============================================================
# Ethereum Phishing Detection Platform — Environment Variables
# Copy to .env and customize
# ============================================================

# ── GCP Configuration (REQUIRED) ──
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# ── Cloud SQL PostgreSQL (GCP) ──
CLOUD_SQL_HOST=34.xxx.xxx.xxx          # Cloud SQL public IP
CLOUD_SQL_CONNECTION_NAME=project:region:instance
POSTGRES_DB=eth_phishing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password  # Set during Cloud SQL creation

# ── GCS Buckets (GCP) ──
GCS_BUCKET_RAW=eth-phishing-raw
GCS_BUCKET_PROCESSED=eth-phishing-processed
GCS_BUCKET_MODELS=eth-phishing-models

# ── Kafka (local) ──
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── MLflow (local server, artifacts → GCS) ──
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── API (local) ──
API_PORT=8000
INFERENCE_MODE=auto        # auto | mock | real
LOG_LEVEL=INFO
# API_KEY=your-api-key-here  # Uncomment for Phase 8

# ── Dashboard (local) ──
DASHBOARD_PORT=8501

# ── Spark (optional, local) ──
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ── Monitoring (optional, local) ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ── External APIs (optional) ──
# ETHERSCAN_API_KEY=your-key-here

# ── Model Artifacts ──
MODEL_ARTIFACTS_DIR=./model_artifacts
MODEL_CURRENT_DIR=current
MODEL_METADATA_FILE=metadata.json
MODEL_FILE=model.pt
MODEL_DEFAULT_THRESHOLD=0.7

# ── Database Connection Pool ──
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Feature & Inference Config ──
BATCH_SIZE=256
MAX_BATCH_ADDRESSES=100
INFERENCE_TIMEOUT_SECONDS=30

# ── BigQuery ──
BIGQUERY_PROJECT=${GCP_PROJECT_ID}
BIGQUERY_DATASET=bigquery-public-data.crypto_ethereum
BIGQUERY_TRANSACTIONS_TABLE=transactions
BIGQUERY_LIMIT=1000000
BIGQUERY_LOOKBACK_DAYS=30

# ── XBlock-ETH (Kaggle) ──
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
XBLOCK_LOCAL_DIR=data/raw/xblock
XBLOCK_KAGGLE_DATASET=xblock/ethereum-phishing-transaction-network

# ── ETL Settings ──
ETL_RAW_PREFIX=transactions
ETL_PARQUET_COMPRESSION=snappy
ETL_JOB_LOG_FILE=_job_log.json
ETL_STATS_FILE=_stats.json
