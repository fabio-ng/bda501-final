# API Configuration
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/phishing_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Model Configuration
INFERENCE_MODE=mock
MODEL_ARTIFACTS_DIR=/app/model_runtime/artifacts
MODEL_DEVICE=cpu
MODEL_CHECKPOINT_NAME=graphsage_model_v1

# GCS Configuration (optional)
GCS_PROJECT_ID=
GCS_BUCKET_MODELS=phishing-models
GCS_BUCKET_DATA=phishing-data
GCS_CREDENTIALS_PATH=

# Kafka Configuration (optional)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREDICTIONS=phishing-predictions

# Prediction Thresholds
PHISHING_SCORE_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.8

# Alert Configuration
AUTO_ALERT_ENABLED=true
AUTO_ALERT_THRESHOLD=0.75

# Batch Processing
MAX_BATCH_SIZE=100

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
